        "bentukKontribusi",
        "strategiPelaksanaan",
        "waktuPelaksanaan",
        "penanggungJawab",
        "sumberPembiayaan",
        "anggaranRencana",
        "indikatorKeberhasilan",
        "targetHasil",
        "status",
        "createdAt",
        "updatedAt"
      ]
