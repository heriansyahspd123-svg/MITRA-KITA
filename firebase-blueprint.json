  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profil Pengawas Sekolah terisolasi per UID pengguna."
    },
    "/schoolProfiles/{userId}": {
      "schema": { "$ref": "#/entities/SchoolProfile" },
      "description": "Profil satuan pendidikan binaan utama milik Pengawas."
    },
    "/partners/{partnerDocId}": {
      "schema": { "$ref": "#/entities/Partner" },
      "description": "Koleksi data mitra sekolah milik masing-masing Pengawas."
    },
    "/programs/{programId}": {
      "schema": { "$ref": "#/entities/PartnershipProgram" },
      "description": "Koleksi program kemitraan sekolah milik masing-masing Pengawas."
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/PartnershipActivity" },
      "description": "Koleksi kegiatan kemitraan yang berelasi dengan program milik Pengawas."
    },
    "/evidences/{evidenceId}": {
      "schema": { "$ref": "#/entities/EvidenceItem" },
      "description": "Koleksi bukti dan dokumentasi kegiatan yang berelasi dengan program milik Pengawas."
    },
    "/evaluations/{evaluationId}": {
      "schema": { "$ref": "#/entities/MonitoringEvaluation" },
      "description": "Koleksi hasil monitoring dan evaluasi 10 indikator milik Pengawas."
    },
    "/supervisorNotes/{noteId}": {
      "schema": { "$ref": "#/entities/SupervisorNote" },
      "description": "Koleksi catatan pembinaan dan rekomendasi Pengawas Sekolah."
    },
    "/aiAnalyses/{analysisId}": {
      "schema": { "$ref": "#/entities/AiAnalysisRecord" },
      "description": "Koleksi riwayat Analisis AI, rekomendasi kemitraan, dan analisis dampak milik Pengawas."
    }
  }
}
