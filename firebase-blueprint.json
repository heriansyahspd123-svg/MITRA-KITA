{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil Pengawas Sekolah yang masuk menggunakan akun Google.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID Firebase Auth milik Pengawas Sekolah."
        },
        "namaPengawas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Nama lengkap Pengawas Sekolah."
        },
        "nip": {
          "type": "string",
          "maxLength": 50,
          "description": "NIP atau ID Pengawas Sekolah."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200,
          "description": "Alamat email akun Google Pengawas."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "URL foto profil Google."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp saat profil dibuat."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp saat profil terakhir diperbarui."
        }
      },
      "required": [
        "ownerUid",
        "namaPengawas",
        "nip",
        "email",
        "photoURL",
        "createdAt",
        "updatedAt"
      ]
    },
    "SchoolProfile": {
      "title": "SchoolProfile",
      "description": "Identitas satuan pendidikan binaan utama untuk kop laporan.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "namaSekolah": {
          "type": "string",
          "maxLength": 200
        },
        "npsn": {
          "type": "string",
          "maxLength": 40
        },
        "kepalaSekolah": {
          "type": "string",
          "maxLength": 150
        },
        "nipKepalaSekolah": {
          "type": "string",
          "maxLength": 50,
          "description": "NIP Kepala Sekolah penanda tangan laporan."
        },
        "namaPengawas": {
          "type": "string",
          "maxLength": 150
        },
        "nipPengawas": {
          "type": "string",
          "maxLength": 50,
          "description": "NIP Pengawas Sekolah penanda tangan laporan."
        },
        "alamatSekolah": {
          "type": "string",
          "maxLength": 400
        },
        "tahunAjaran": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "namaSekolah",
        "npsn",
        "kepalaSekolah",
        "namaPengawas",
        "alamatSekolah",
        "tahunAjaran",
        "createdAt",
        "updatedAt"
      ]
    },
    "Partner": {
      "title": "Partner",
      "description": "Data mitra sekolah binaan beserta kontak dan potensi kerja sama.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "namaSekolah": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kategori": {
          "type": "string",
          "enum": [
            "Orang Tua",
            "Komite Sekolah",
            "Puskesmas",
            "UMKM",
            "Dunia Usaha",
            "Pemerintah Desa/Kelurahan",
            "Perguruan Tinggi",
            "Komunitas Pendidikan",
            "Organisasi Masyarakat",
            "Lainnya"
          ]
        },
        "penanggungJawab": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "telepon": {
          "type": "string",
          "maxLength": 40
        },
        "alamat": {
          "type": "string",
          "maxLength": 400
        },
        "jenisKontribusi": {
          "type": "string",
          "maxLength": 500
        },
        "potensiKerjaSama": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["Aktif", "Dalam Penjajakan", "Tidak Aktif"]
        },
        "catatan": {
          "type": "string",
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "namaSekolah",
        "nama",
        "kategori",
        "penanggungJawab",
        "telepon",
        "alamat",
        "jenisKontribusi",
        "potensiKerjaSama",
        "status",
        "catatan",
        "createdAt",
        "updatedAt"
      ]
    },
